# URL da aplicacao que sera testada.
BASE_URL=http://localhost:5000
CURL_CONNECT_TIMEOUT=5
CURL_MAX_TIME=30

# Use estas mesmas variaveis ao executar `flask --app app seed-db` para criar
# a conta administrativa. ADMIN_EMAIL/ADMIN_PASSWORD abaixo sao as credenciais
# que o script enviara ao endpoint /login.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=use-um-segredo-forte
ADMIN_EMAIL="$SEED_ADMIN_EMAIL"
ADMIN_PASSWORD="$SEED_ADMIN_PASSWORD"

# A conta cliente e criada pelo proprio teste caso ainda nao exista.
# Em execucoes posteriores, as mesmas credenciais sao reutilizadas.
CLIENT_NAME="Cliente teste pos-refactor"
CLIENT_EMAIL=cliente.pos.refactor@example.com
CLIENT_PASSWORD=cliente123

# Protecao independente do POST /admin/reset-db. Para testar o reset com
# sucesso, configure o mesmo valor no processo da aplicacao e altere
# TEST_RESET_DB para true. ATENCAO: o reset remove todos os dados e roda por
# ultimo. Com false, o endpoint e testado de forma segura, esperando HTTP 403.
ADMIN_TOKEN=
TEST_RESET_DB=false

# true imprime tambem o JSON devolvido em cada chamada.
VERBOSE=false
